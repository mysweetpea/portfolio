---
// Nav.astro — THE single source of truth for site navigation.
//
// WHY THIS EXISTS: the live site hand-duplicates nav markup across 14 HTML files
// and NONE match `_partials/nav.html` byte-for-byte (drift is measured, not
// theoretical). A nav change currently means 14 edits.
//
// ⚠️ Structure is copied EXACTLY from the live nav (verified by parsing it, not
// from memory — a first pass guessed 5 top-level links when there are 3 + 7):
//   3 inline links (Services / How It Works / I Have a Code)
//   + a <details class="nav-more"> "More" menu holding 6 links + GitHub
//   + Get Access CTA, search, theme toggle, SSO chip.
//
// ⚠️ `current` drives aria-current="page". It is DERIVED, never hand-set — the
// hand-copied version had already drifted on this.
//
// ⚠️ The SSO chip's markup, inline <style> and inline <script> must stay
// together: the script calls /api/auth/state?name=1 (proxied by the site worker)
// and swaps in the signed-in user's name + avatar.

const { current = "" } = Astro.props;

const INLINE = [
  { href: "/services.html", label: "Services",      key: "services" },
  { href: "/pricing.html",  label: "How It Works",  key: "pricing" },
  { href: "/redeem.html",   label: "I Have a Code", key: "redeem" },
];
const MORE = [
  { href: "/support.html",  label: "Donate",           key: "support" },
  { href: "/suggest.html",  label: "Suggest a Service", key: "suggest" },
  { href: "/contact.html",  label: "Contact Us",       key: "contact" },
  { href: "/status.html",   label: "Status",           key: "status" },
  { href: "/changelog.html",label: "Changelog",        key: "changelog" },
  { href: "/about.html",    label: "About",            key: "about" },
];
const ac = (k) => (current === k ? "page" : undefined);

// The SSO chip's style + script, extracted VERBATIM from the live nav so the
// emitted bytes match. `is:inline` is REQUIRED on both:
//   • the script must stay byte-stable — the CSP in _headers is a static sha256
//     allowlist and postbuild.mjs recomputes the hashes from the built output;
//     Astro bundling it would change the hash and break the policy.
//   • the style must not be hoisted into a <link>, which would change paint order.
import chipCss from "./nav-parts/chip.css?raw";
import chipJs from "./nav-parts/chip.js?raw";
---

<nav class="top-nav" aria-label="Main">
  <a href="/index.html" class="nav-logo">
    <img src="/logo.svg" width="32" height="32" alt="" aria-hidden="true" decoding="async" />
    <span>MySweetPea</span><span class="nav-tagline">Your Private Garden</span>
  </a>

  <div class="nav-links" id="navLinks">
    {INLINE.map((l) => <a href={l.href} class="nav-btn" aria-current={ac(l.key)}>{l.label}</a>)}

    <details class="nav-more">
      <summary class="nav-btn">More<svg class="nav-chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
      <div class="nav-more-menu">
        {MORE.map((l) => <a href={l.href} aria-current={ac(l.key)}>{l.label}</a>)}
        <a href="https://github.com/mysweetpea" class="nav-btn nav-github" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </details>

    <a href="/form.html" class="nav-cta">Get Access</a>

    <div class="nav-actions">
      <button class="nav-search" aria-label="Search pages and services" title="Search (Ctrl+K)">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <button class="theme-toggle" aria-label="Toggle color theme">
        <span class="icon-moon" aria-hidden="true"><img src="/assets/icons/icon-ui-moon.svg" alt="" width="18" height="18" loading="lazy" decoding="async" /></span>
        <span class="icon-sun" aria-hidden="true"><img src="/assets/icons/icon-ui-sun.svg" alt="" width="18" height="18" loading="lazy" decoding="async" /></span>
      </button>
    </div>

    <div class="nav-account" id="nav-account">
      <button type="button" class="nav-btn nav-signin nav-account-chip" id="nav-account-chip" aria-expanded="false" aria-controls="nav-account-pop" aria-haspopup="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
        <img id="nav-account-avatar" alt="" hidden style="width:22px;height:22px;border-radius:50%;object-fit:cover;display:none" />
        <span id="nav-account-label">Sign in</span>
      </button>
      <div class="nav-account-pop" id="nav-account-pop" hidden>
        <a class="nap-primary" href="https://dashboard.mysweetpea.cc/auth/login">Open dashboard</a>
      </div>
    </div>
  </div>

  {/* Chip styles + behaviour. Kept inside <nav> in the same position as the live
      markup so paint order and cascade stay identical. */}
  <style is:inline set:html={chipCss} />
  <script is:inline set:html={chipJs} />
</nav>
