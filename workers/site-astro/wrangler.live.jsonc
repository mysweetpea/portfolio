{
  // LIVE deploy -> mysweetpea.cc. Identical to workers/site/wrangler.jsonc
  // except assets.directory points at the Astro build output.
  //
  // The worker script is the SAME index.js (diff-verified identical to the live
  // one), so the only thing changing is the static tree it serves.
  "name": "site",
  "compatibility_date": "2026-06-25",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/.well-known/matrix/*"]
  },
  "routes": [
    { "pattern": "mysweetpea.cc", "custom_domain": true },
    { "pattern": "www.mysweetpea.cc", "custom_domain": true }
  ]
}
