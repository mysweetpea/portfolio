# MySweetPea site — static-asset response headers (served by the assets layer).
# Replaces the per-request header block that used to live in the Worker.
# Deploy-time validated by Cloudflare (_headers syntax errors fail the deploy).
#
# CSP uses build-time sha256 hashes of the inline scripts (bake_html.py computes
# them). If you edit inline JS in any .html file, re-run:
#   python bake_html.py --check     -> prints the new hash list
# and update the script-src line below.
#
# CORP strategy (learned live): the base /* rule carries NO CORP. A base-rule
# CORP + per-page detach produced DUPLICATE conflicting values on `/`
# (same-origin AND cross-origin). Instead: pages set same-origin, asset
# extensions set cross-origin. No rule ever needs to detach.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-DNS-Prefetch-Control: off
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-/NotsO1XrklUBFD8ZEeWf3MVjrNvOtddgYL23LjaQz4==' 'sha256-28kQcfCK2RFymnK8DACIn4ID1lJuaQMwq1vszRX+e7g==' 'sha256-7iD7sqVwXQIkDx25TsUDtL43UTzpZuz8aZnS5VldSuw==' 'sha256-8BtD1g9hS4aze7Bg+5aTkA+cPCT8B+QDiQXX/0c5Y7k==' 'sha256-9ToyzHPsmJPURvIk/eSNnWcuk+TkV3fD2+vGZo1+dsU==' 'sha256-M4kqTcLdV7oq6p85wYV2vqNY8wGRnOIWfTg3k3GYdDA==' 'sha256-OJXEv+uMWj1c9q1XwA9QnBGUhCH5I8o1an3jl7Q8YIU==' 'sha256-TfXuUD3KHeEeY3neF82t8Q8g+xuf99liC8Z247bSluo==' 'sha256-ZlwxRBoOmsEWECgUIlM9BePy8riGn1UFLarXHKfgnAk==' 'sha256-btn1TIDE171Teqk1GTieljk+2jxGe4FpoQVKBEtX9hI==' 'sha256-hx3VqhJWLXuBPUgD78DK5pBZ0gYzqh4e31M5sziB7r0==' 'sha256-jD8XSNtBttUPhhfcoA11uXkRDRwKu90bysfLLrxuF3g==' 'sha256-lo/el3/mwCuWrkUqKRSPLxKTD/GKof8XS/xICnTgsT8==' 'sha256-oAAE84iUF/TxncKqoQvO4fio8qtMEJCxQOKp0Ys5rqk==' 'sha256-q+ucn2KX8FOorzD2ahLXAkN9wN3EkypgTJoynhK8MVg=='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://subscribe.mysweetpea.cc https://status.mysweetpea.cc; object-src 'none'; base-uri 'self'; form-action 'self' https://subscribe.mysweetpea.cc; frame-ancestors 'none'; upgrade-insecure-requests

