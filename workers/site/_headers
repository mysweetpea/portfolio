# MySweetPea site — static-asset response headers (served by the assets layer).
# Replaces the per-request header block that used to live in the Worker.
# Deploy-time validated by Cloudflare (_headers syntax errors fail the deploy).
#
# CSP uses build-time sha256 hashes of the inline scripts (bake_html.py computes
# them). If you edit inline JS in any .html file, re-run:
#   python bake_html.py --check     -> prints the new hash list
# and update the script-src line below.
#
# CORP strategy (learned live): the base /* rule carries NO CORP. A base-rule
# CORP + per-page detach produced DUPLICATE conflicting values on `/`
# (same-origin AND cross-origin). Instead: pages set same-origin, asset
# extensions set cross-origin. No rule ever needs to detach.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-DNS-Prefetch-Control: off
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-B5G/BQokytVmDInbcHO7nFTxJ+FYpliakaWD1R504xk=' 'sha256-EdId8M5ecQUbIZhjSQqA1ACut8Bz0gJlYS+oDvrwvQY=' 'sha256-GfhADrERxVFD6LEN5R13yRX1sYkmI5m8QNY3BDsVVPI=' 'sha256-Uyb06t/vsvzsyIHntpKqS7UJLzRwbz/kt4sazCcEnAU=' 'sha256-W+bzrn21VZW01JlhUp1jAgpwwauIuiW0r+w/sX3VHyg=' 'sha256-bvDXqY822vg0dsPGe4+D1al0Xw2zcSoUQCwZm3NR1xc=' 'sha256-d4/nhnmw/7tbRrzsy7iuYTAOe1inU4VTTvQkaQabmlg=' 'sha256-paHWtb58RJhtn3STcH0i7MmIZT3Il+N/YzTW4kQmR+A=' 'sha256-q+ucn2KX8FOorzD2ahLXAkN9wN3EkypgTJoynhK8MVg='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://subscribe.mysweetpea.cc https://status.mysweetpea.cc; object-src 'none'; base-uri 'self'; form-action 'self' https://subscribe.mysweetpea.cc; frame-ancestors 'none'; upgrade-insecure-requests

