# Assets -> CORP cross-origin (parity with the old worker: non-HTML got
# cross-origin so other origins like auth.mysweetpea.cc can embed them —
# a blanket same-origin once broke the Authentik login logo).
/*.css
  Cross-Origin-Resource-Policy: cross-origin
/*.js
  Cross-Origin-Resource-Policy: cross-origin
/*.json
  Cross-Origin-Resource-Policy: cross-origin
/*.txt
  Cross-Origin-Resource-Policy: cross-origin
/*.xml
  Cross-Origin-Resource-Policy: cross-origin
/*.woff
  Cross-Origin-Resource-Policy: cross-origin
/*.woff2
  Cross-Origin-Resource-Policy: cross-origin
/*.svg
  Cross-Origin-Resource-Policy: cross-origin
/*.png
  Cross-Origin-Resource-Policy: cross-origin
/*.webp
  Cross-Origin-Resource-Policy: cross-origin
/*.jpg
  Cross-Origin-Resource-Policy: cross-origin
/*.jpeg
  Cross-Origin-Resource-Policy: cross-origin
/*.gif
  Cross-Origin-Resource-Policy: cross-origin
/*.ico
  Cross-Origin-Resource-Policy: cross-origin
/*.mp4
  Cross-Origin-Resource-Policy: cross-origin
/*.webm
  Cross-Origin-Resource-Policy: cross-origin

# Long-lived caching for fonts/images (parity with the old worker's rule:
# woff2|svg|png|webp). CSS/JS keep the assets default (must-revalidate + ETag)
# because they are version-busted via ?v= in the HTML.
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable

# workers.dev lane: don't get indexed
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
