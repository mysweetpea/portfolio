 [data-theme="light"] .toast { background: rgba(255, 255, 255, 0.95); color: var(--text); box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15); }
 [data-theme="light"] .ascii-hero { border-color: var(--border-primary); }
