+        height: 19px;
+        margin: 0 3px 0 7px;
+        background: var(--border-primary);
+        opacity: 0.7;
+    }
+}
+
+/* ==========================================================================
+   Mobile / tablet (<=1099px): the site's existing drawer pattern, widened
+   from the old 768px breakpoint. Same rules the live drawer uses (site.css
+   v28 + the section-11 mobile block), restated here so the whole 0-1099px
+   range is one coherent treatment. Sticky bar, wordmark at the brand
+   position, full-width card items, centred search/theme pill pair, and the
+   menu grows in normal page flow (NO max-height / overflow — the page
+   scrolls).
+   ========================================================================== */
+@media (max-width: 1099.98px) {
+    .top-nav {
+        position: sticky;
