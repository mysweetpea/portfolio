+/* ==========================================================================
+   === 12. Nav v3 — "Terminal + Crowned" (2026-09-18) =======================
+   The approved redesign (.oc-tmp/nav-options.html, concept 4 "The hybrid"):
+   terminal voice (monospace links, one 12x12 glyph per item, current page
+   sage) in the crowned structure (Fraunces wordmark dead centre, links split
+   3/2 around it), under an always-on glass bar, with ONE ice-white action.
+
+   >=1100px: grid 1fr auto 1fr. LEFT (right-aligned): Services, How It
+   Works, Status. CENTRE: wordmark. RIGHT (left-aligned): About, I Have a
+   Code, hairline separator, search, theme, account, Get Access.
+   <=1099px: the site's existing hamburger drawer pattern — sticky bar,
+   wordmark back at the brand position beside the toggle, full-width card
+   items, search/theme as a centred pill pair inside the drawer, and NO
+   nested scroll container (the menu grows in page flow; the page scrolls).
+
+   Signed in, the account chip is promoted into the ice slot and "Get Access"
+   disappears (a member already has access — offering it again reads as a
+   bug). `.nav-signed-in` is set by assets/js/site.js (external file, so the
+   CSP sha256 allowlist is untouched) by READING the account chip's own
+   mutations — the chip markup + its inline <style>/<script> were copied
+   VERBATIM from the previous nav and no new inline script/style exists.
+   ========================================================================== */
+
+/* --- The bar: always-on glass (mockup .nv4) --- */
+.top-nav {
+    gap: 14px;
+    background: rgba(12, 19, 22, 0.62);
+    backdrop-filter: blur(18px) saturate(1.4);
+    -webkit-backdrop-filter: blur(18px) saturate(1.4);
+}
+[data-theme="light"] .top-nav { background: rgba(233, 239, 234, 0.76); }
+
+/* --- Terminal voice: mono links, one glyph each (mockup .nv4 .links a) --- */
+.top-nav .nav-btn {
+    display: inline-flex;
+    align-items: center;
+    gap: 7px;
+    padding: 8px 10px;
+    background: transparent;
+    border: 0;
+    border-radius: 8px;
+    color: var(--text-dim);
+    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+    font-size: 0.775rem;
+    letter-spacing: -0.01em;
+    white-space: nowrap;
+    cursor: pointer;
+}
+.top-nav .nav-btn svg { flex: none; opacity: 0.6; transition: opacity 0.18s; }
+.top-nav .nav-btn:hover {
+    color: var(--primary-bright);
+    background: transparent;
+    text-shadow: none;
+}
+.top-nav .nav-btn:hover svg { opacity: 1; }
+.top-nav .nav-btn[aria-current="page"] { color: var(--sage); background: transparent; border-color: transparent; }
+.top-nav .nav-btn[aria-current="page"] svg { opacity: 1; }
+/* The v11 centred hairline is retired by the sage tint + solid glyph. */
+.top-nav .nav-btn[aria-current="page"]::after { content: none; }
+
+/* Sign in (signed OUT): quiet mono text link, deliberately NOT a second
+   button (mockup .acct). The person glyph is trimmed 18 -> 15px in CSS only —
+   the chip markup is CSP-hashed and must stay byte-identical. */
+.top-nav .nav-signin {
+    margin-left: 9px;
+    padding: 8px 11px;
+    border: 0;
+    border-radius: 8px;
+    background: transparent;
+    color: var(--text-dim);
+    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+    font-size: 0.775rem;
+    letter-spacing: -0.01em;
+    white-space: nowrap;
+    cursor: pointer;
+    transition: color 0.18s, background 0.18s, box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
+}
+.top-nav .nav-signin:hover {
+    color: var(--primary-bright);
+    background: var(--primary-glow);
+    border: 0;
+}
+.top-nav .nav-account-chip svg { width: 15px; height: 15px; }
+
+/* The ONE bold object, signed out: ice pill, mono (mockup .nv4 .cta). */
+.top-nav .nav-cta {
+    margin-left: 10px;
+    padding: 9px 17px;
+    border-radius: 6px;
+    background: var(--ice);
+    color: #0C1316;
+    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+    font-size: 0.79rem;
+    font-weight: 600;
+    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
+                box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1),
+                background 0.3s;
+}
+.top-nav .nav-cta:hover {
+    transform: translateY(-1px);
+    box-shadow: 0 6px 22px rgba(238, 242, 243, 0.22);
+}
+[data-theme="light"] .top-nav .nav-cta { background: #1B2B31; color: #EDF3F4; }
+[data-theme="light"] .top-nav .nav-cta:hover { box-shadow: 0 6px 22px rgba(27, 43, 49, 0.25); }
+
+/* --- SIGNED IN: the chip takes the ice slot; "Get Access" disappears.
+   Mockup stage "Signed in" (.nv4 .acct--member). Driven by .nav-signed-in,
+   set by site.js from the chip's own label/avatar mutations. The pill never
+   clips the popup: the popup hangs off .nav-account (position:relative in the
+   chip's own inline style), not off this button, and nothing here sets
+   overflow on the wrapper. --- */
+.top-nav.nav-signed-in .nav-cta { display: none; }
+.top-nav.nav-signed-in .nav-account-chip {
+    margin-left: 9px;
+    padding: 6px 14px 6px 7px;
+    border: 0;
+    border-radius: 999px;
+    background: var(--ice);
+    color: #0C1316;
+    font-weight: 600;
+}
+.top-nav.nav-signed-in .nav-account-chip:hover {
+    background: #fff;
+    color: #0C1316;
+    transform: translateY(-1px);
+    box-shadow: 0 6px 22px rgba(238, 242, 243, 0.22);
+}
+.top-nav.nav-signed-in .nav-account-chip > svg { display: none; }
+.top-nav.nav-signed-in .nav-account-chip #nav-account-avatar { box-shadow: inset 0 0 0 1.5px rgba(12, 19, 22, 0.16); }
+[data-theme="light"] .top-nav.nav-signed-in .nav-account-chip { background: #1B2B31; color: #EDF3F4; }
+[data-theme="light"] .top-nav.nav-signed-in .nav-account-chip:hover {
+    background: #0d1b20;
+    color: #fff;
+    box-shadow: 0 6px 22px rgba(27, 43, 49, 0.25);
+}
+[data-theme="light"] .top-nav.nav-signed-in .nav-account-chip #nav-account-avatar { box-shadow: inset 0 0 0 1.5px rgba(237, 243, 244, 0.25); }
+
+/* --- Desktop crown (mockup .nv4 grid) --- */
+@media (min-width: 1100px) {
+    .top-nav {
+        display: grid;
+        grid-template-columns: 1fr auto 1fr;
+        align-items: center;
+        padding: 13px 30px;
+    }
+    .top-nav.nav-scrolled { padding: 10px 30px; }
+    .nav-toggle { display: none; }
+
+    /* #nav-links dissolves so its two groups become the grid's flanks */
+    .top-nav .nav-links { display: contents; }
+    .nav-group { display: flex; align-items: center; gap: 2px; min-width: 0; }
+    .nav-group-l { grid-column: 1; justify-content: flex-end; }
+    .nav-group-r { grid-column: 3; justify-content: flex-start; }
+
+    .top-nav .nav-logo {
+        grid-column: 2;
+        gap: 9px;
+        padding: 0 18px;
+        text-decoration: none;
+    }
+    .top-nav .nav-logo img { width: 25px; height: 25px; display: block; }
+    .top-nav .nav-brand {
+        font-family: 'Fraunces', Georgia, serif;
+        font-weight: 600;
+        font-size: 1.06rem;
+        letter-spacing: -0.01em;
+        color: var(--text);
+        white-space: nowrap;
+    }
+
+    /* hairline between the last link and the actions cluster (mockup .acct-sep) */
+    .nav-sep {
+        flex: none;
